{
  "buildCommand": "echo ok",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/kayros/",
      "destination": "/kayros",
      "permanent": false
    },
    {
      "source": "/entrar",
      "destination": "/ecossistema/entrar",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/kayros",
      "destination": "https://kayros-app.vercel.app/kayros"
    },
    {
      "source": "/kayros/:path*",
      "destination": "https://kayros-app.vercel.app/kayros/:path*"
    },
    {
      "source": "/ecossistema",
      "destination": "https://eco-hq-kayros3.vercel.app/ecossistema"
    },
    {
      "source": "/ecossistema/:path*",
      "destination": "https://eco-hq-kayros3.vercel.app/ecossistema/:path*"
    }
  ]
}
